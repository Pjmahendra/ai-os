# Dependencies
node_modules/
**/node_modules/

# Build
dist/
build/
coverage/
.next/
# TypeScript incremental build cache. Committing this while dist/ is
# gitignored is actively wrong, not just unnecessary: tsc's
# incremental logic compares against this file's recorded state and
# concludes "nothing changed since last build" on a fresh clone (where
# dist/ never existed), so it skips writing dist/ entirely - a build
# that reports success while silently producing no output.
**/*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Turborepo
.turbo/

# Temporary
tmp/
temp/

# Local AI-agent tooling metadata (e.g. Neon CLI/skill installs) -
# not part of the application.
.neon
.agents/
skills-lock.json